# Supabase (get these from Supabase Dashboard > Project Settings > API for project pkydkbuodikttfeawqsw)
NEXT_PUBLIC_SUPABASE_URL=https://pkydkbuodikttfeawqsw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase auth (@supabase/server, used by src/app/api/analyze/route.ts
# to verify the caller's JWT via JWKS instead of round-tripping to the Auth API).
# Non-secret — same project as above, publishable/URL values are safe to commit as
# examples. Do NOT add SUPABASE_SECRET_KEY here or to any committed file.
SUPABASE_URL=https://pkydkbuodikttfeawqsw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_obr-7Y0u02p5c5pD-5f3Sw_zda5lWTa
SUPABASE_JWKS_URL=https://pkydkbuodikttfeawqsw.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SECRET_KEY=sb_secret_...   # only needed if a route starts using createAdminClient/auth:'secret'

# Claude (Constraint Validator artifact analysis). Server-only — do NOT prefix
# with NEXT_PUBLIC_, or the key ships in the client bundle. Set this in the
# Vercel project's environment variables, not just locally.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Add other envs as needed
